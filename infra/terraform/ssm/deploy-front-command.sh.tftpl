# homestamp-deploy-front 문서가 앱 EC2에서 root로 실행하는 명령(SSM Agent). 이 파일만 고치면 문서가 바뀐다(Terraform).
# 백엔드 문서(deploy-command.sh.tftpl)와 같은 경계: 입력은 Digest 하나(ENV_VAR로만 받고 명령 본문에 끼워 넣지 않음),
# 실행하는 것은 해시를 고정한 /opt/homestamp/deploy/deploy-front.sh 하나뿐이다. 이 스크립트는 다른 실행 파일을 부르지 않는다
# (nginx 전환기 없음: 화면은 current 링크만 바꾸고 reload하지 않는다).
# 백엔드와 화면의 이미지 저장소가 같으면 실행하지 않는다(서로의 이미지를 섞지 않게).
# 종료 코드: deploy-front.sh의 코드를 그대로 돌려준다(2~24, 신호 129·130·143). 이 명령 자체: 2 입력·설정, 20 승인된 해시 없음, 21 파일 소유자·권한·해시 다름
# shellcheck disable=SC2154  # SSM_Digest는 SSM Agent가 넣는다(없으면 set -u로 멈춤)
set -euo pipefail
set +x
digest="$SSM_Digest"
[[ "$digest" =~ ^sha256:[0-9a-f]{64}$ ]] || { echo "deploy-front-doc: digest 형식이 아닙니다"; exit 2; }
expected="${expected_sha256}"
[[ "$expected" =~ ^[0-9a-f]{64}$ ]] || { echo "deploy-front-doc: 승인된 deploy-front.sh 해시가 문서에 없습니다(Terraform deploy_front_script_sha256)"; exit 20; }
dir=/opt/homestamp/deploy
script="$dir/deploy-front.sh"
config="$dir/deploy-front.env"
# root 소유이고 그룹·다른 사용자가 쓸 수 없어야 한다(심볼릭 링크 거절)
for f in / /opt /opt/homestamp "$dir" "$script" "$config"; do
  if [[ -L "$f" || ! -e "$f" ]]; then echo "deploy-front-doc: $f 가 없거나 링크입니다"; exit 21; fi
  owner="$(stat -c '%u' "$f")"
  mode="$(stat -c '%a' "$f")"
  if [[ "$owner" != 0 ]] || (( 8#$mode & 8#022 )); then echo "deploy-front-doc: $f 소유자·권한이 다릅니다"; exit 21; fi
done
if [[ ! -f "$script" ]]; then echo "deploy-front-doc: deploy-front.sh가 일반 파일이 아닙니다"; exit 21; fi
actual="$(sha256sum "$script" | cut -d' ' -f1)"
[[ "$actual" == "$expected" ]] || { echo "deploy-front-doc: deploy-front.sh 해시가 승인된 값과 다릅니다"; exit 21; }
repo="$(grep -E '^IMAGE_REPOSITORY=' "$config" | tail -n 1 | cut -d= -f2- || true)"
[[ -n "$repo" ]] || { echo "deploy-front-doc: deploy-front.env에 IMAGE_REPOSITORY가 없습니다"; exit 2; }
back_repo=""
if [[ -f "$dir/deploy.env" ]]; then back_repo="$(grep -E '^IMAGE_REPOSITORY=' "$dir/deploy.env" | tail -n 1 | cut -d= -f2- || true)"; fi
[[ "$repo" != "$back_repo" ]] || { echo "deploy-front-doc: 화면과 백엔드의 IMAGE_REPOSITORY가 같습니다(섞지 않음)"; exit 2; }
echo "deploy-front-doc: deploy-front.sh $actual"
# 출력은 끝 20,000바이트만(SSM 24,000자 제한에 마지막 결과 줄 "끝: result=…"이 잘리지 않게). 신호는 deploy-front.sh에 넘긴다
out="$(mktemp)"
trap 'rm -f "$out"' EXIT
set +e
"$script" --config "$config" "$repo@$digest" >"$out" 2>&1 &
pid=$!
printed=false
on_signal() {
  kill -TERM "$pid" 2>/dev/null
  tail -c 20000 "$out"
  printed=true
}
trap on_signal TERM INT HUP
wait "$pid"
rc=$?
while kill -0 "$pid" 2>/dev/null; do
  wait "$pid"
  rc=$?
done
if $printed; then
  echo "deploy-front-doc: 신호로 멈춤, deploy-front.sh 끝 출력:"
  tail -c 2000 "$out"
else
  tail -c 20000 "$out"
fi
exit "$rc"
