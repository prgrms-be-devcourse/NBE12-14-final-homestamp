# /opt/homestamp/nginx/homestamp.env로 복사해 쓴다(비밀값 없음). render.sh·renew.sh가 KEY=value 줄만 읽는다
# 개인 계정으로 옮기면 DOMAIN·PHOTOS_BUCKET만 바꾼다
DOMAIN=homestamp.cloud
PHOTOS_BUCKET=homestamp-photos
# 처음 한 번만 쓰는 앱 주소(배포 스크립트가 blue를 127.0.0.1:8081에 묶는다고 가정, 제안값)
APP_UPSTREAM=127.0.0.1:8081
# HTTPS가 잘 도는 것을 확인하기 전에는 비워 둔다(런북 "HSTS 켜기")
HSTS_MAX_AGE=
