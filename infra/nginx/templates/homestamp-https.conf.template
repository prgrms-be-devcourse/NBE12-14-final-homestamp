# 인증서가 있을 때. 80은 ACME 확인과 HTTPS로 보내기만, 443에서 TLS를 끝내고 화면·API를 낸다

# /assets/ 캐시: 해시 이름 파일이 실제로 있을 때(200·304)만 오래 둔다. 없는 파일(404)·오류는 저장하지 않게 한다
# (immutable 404가 남으면 나중에 복구한 파일도 브라우저가 받지 않음)
map $status $homestamp_assets_cache {
  200 "public, max-age=31536000, immutable";
  304 "public, max-age=31536000, immutable";
  default "no-store";
}

# 우리 도메인이 아닌 Host는 끊는다. 443은 인증서를 내보이지 않고 TLS 핸드셰이크를 거절한다
server {
  listen 80 default_server;
  server_name _;
  return 444;
}

server {
  listen 443 ssl default_server;
  server_name _;
  ssl_reject_handshake on;
}

server {
  listen 80;
  server_name __DOMAIN__;

  # 갱신(certbot renew)도 80의 이 경로로 확인한다
  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type text/plain;
    try_files $uri =404;
  }

  location / {
    return 301 https://__DOMAIN__$request_uri;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name __DOMAIN__;

  # Let's Encrypt가 준 체인(fullchain)과 키. 키는 root만 읽는다(certbot 기본 권한, 컨테이너에는 읽기 전용으로)
  ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;

  # Mozilla "intermediate": TLS 1.2·1.3, 전방 보안 AEAD만
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:homestamp_tls:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;
  # OCSP stapling은 쓰지 않는다(Let's Encrypt가 2025년에 인증서의 OCSP 주소를 빼고 응답 서버를 끈다고 공지)

  root /srv/homestamp/front/current;
  index index.html;

  # API → 현재 앱
  location /api/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Cache-Control "no-store" always;
    include /etc/nginx/snippets/proxy-api.conf;
  }

  location @api_unavailable {
    include /etc/nginx/snippets/security-headers.conf;
    default_type application/problem+json;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Cache-Control "no-store" always;
    return 503 '{"type":"about:blank","title":"Service Unavailable","status":503}';
  }

  # Actuator·API 문서는 바깥에 내지 않는다(04 3-2 "막기"). 앱의 관리 포트는 9091·9092로 따로 있다
  location ~ ^/(actuator|v3/api-docs|swagger-ui)(/|$) {
    return 404;
  }

  # 점 파일(.env, .git 등)은 내지 않는다
  location ~ /\. {
    return 404;
  }

  # 문자 링크 화면: Referer로 링크 주소가 새지 않게(04 3-2)
  location = /l {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cache-Control "no-cache" always;
    try_files /index.html =404;
  }

  # 빌드 결과의 해시가 붙은 파일(Vite assets)은 릴리스가 아니라 공용 불변 폴더(/srv/homestamp/front/assets)에서 낸다.
  # 이전·새 판의 index.html이 부르는 파일이 전환·되돌리기 중에도 같이 있게(deploy-front.sh, 런북 배포-화면.md).
  # 없는 파일은 404(index.html로 대신 답하지 않음). 이름이 내용 해시라 오래 캐시한다
  location /assets/ {
    root /srv/homestamp/front;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Cache-Control $homestamp_assets_cache always;
    try_files $uri =404;
  }
  # 지금 나가는 판(배포 확인용). 없으면 404(index.html로 대신 답하지 않음), 캐시하지 않는다
  location = /version.json {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Cache-Control "no-store" always;
    try_files $uri =404;
  }

  # 그 밖은 React 화면(없는 경로는 index.html로 보내 화면의 라우터가 처리)
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Cache-Control "no-cache" always;
    try_files $uri /index.html;
  }
}
