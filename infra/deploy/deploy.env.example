# /opt/homestamp/deploy/deploy.env (비밀값 없음. 저장소에는 이 예시만). 줄 형식은 KEY=value
# 비어 있는 필수값은 정해지는 대로 채운다. 비어 있으면 deploy.sh가 멈춘다

# 필수: CD가 올리는 GHCR 저장소(이 저장소의 이미지만 배포한다). 이름은 deploy.yml을 만들 때 정한다
IMAGE_REPOSITORY=
# 필수: Migration·GRANT 실행 UID:GID(비밀 폴더 소유자와 같게, 0 아님). 비밀 폴더를 준비하는 절차와 함께 정한다
MIGRATION_UID=
# 필수: 전환 뒤 nginx를 거쳐 앱이 답하는지 볼 주소. 인증 없이 /api/면 앱만 401을 준다(nginx의 404·503은 실패).
# nginx가 127.0.0.1 요청에만 답한 앱 주소(X-Homestamp-Upstream)를 붙이므로 RESOLVE는 127.0.0.1이어야 한다
POST_SWITCH_URL=https://homestamp.cloud/api/
POST_SWITCH_RESOLVE=homestamp.cloud:443:127.0.0.1
POST_SWITCH_EXPECT=401

# 아래는 기본값과 같다(04 3-2 블루/그린 포트, decisions 2026-11-25)
BLUE_PORT=8081
GREEN_PORT=8082
NAME_PREFIX=homestamp-app
MIGRATION_SECRETS_DIR=/run/secrets/homestamp-migration
UPSTREAM_FILE=/opt/homestamp/nginx/run/upstream/upstream.conf
SWITCH_CMD=/opt/homestamp/nginx/switch-upstream.sh
STATE_DIR=/var/lib/homestamp/deploy
LOCK_FILE=/run/lock/homestamp-deploy.lock
HEALTH_TIMEOUT=120
APP_MEMORY=800m
STOP_TIMEOUT=30
# 일회성 실행 제한 시간(초). 넘기면 멈추고 11·12로 끝낸다
MIGRATE_TIMEOUT=900
GRANTS_TIMEOUT=300
# 전환 뒤 확인을 다시 묻는 시간(초)
VERIFY_TIMEOUT=20
