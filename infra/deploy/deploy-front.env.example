# /opt/homestamp/deploy/deploy-front.env (비밀값 없음. 저장소에는 이 예시만). 줄 형식은 KEY=value
# 화면(React) 배포 설정. 백엔드 deploy.env와 따로 둔다(같은 것은 잠금 파일 하나). 런북 docs/runbooks/배포-화면.md

# 필수: CD가 올리는 화면 GHCR 저장소(백엔드 IMAGE_REPOSITORY와 달라야 한다. 같으면 SSM 문서가 멈춤)
IMAGE_REPOSITORY=
# 필수: 전환 뒤 실제 응답을 볼 주소(HTTPS, TLS 검증 유지). RESOLVE로 이 서버의 nginx에 붙는다
VERIFY_URL=https://homestamp.cloud
VERIFY_RESOLVE=homestamp.cloud:443:127.0.0.1

# 아래는 기본값과 같다
FRONT_ROOT=/srv/homestamp/front
# 백엔드 STATE_DIR(/var/lib/homestamp/deploy)와 같으면 멈춘다
STATE_DIR=/var/lib/homestamp/deploy-front
LOCK_FILE=/run/lock/homestamp-deploy.lock
# 전환 뒤 확인을 다시 묻는 시간(초). 되돌린 뒤 확인도 같은 시간
VERIFY_TIMEOUT=20
# 보존: 최근 정상 릴리스 수, 되돌린(노출됐던) 릴리스 manifest 수
KEEP_RELEASES=3
KEEP_EXPOSED=2
# 이미지 파일 한도(check-front.sh와 같은 값). 넘으면 24
MAX_FILES=2000
MAX_FILE_BYTES=10485760
MAX_RELEASE_BYTES=52428800
# 꺼내기 전에 FRONT_ROOT 파일시스템에 남아 있어야 하는 공간(바이트). 모자라면 24로 멈추고 아무것도 바꾸지 않는다
MIN_FREE_BYTES=1073741824
