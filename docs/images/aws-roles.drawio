nded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;strokeWidth=1.5;dashed=0;edgeStyle=orthogonalEdgeStyle;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="OIDC" style="rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;strokeWidth=1.5;dashed=0;edgeStyle=none;" edge="1" parent="1" source="c9" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="OIDC" style="rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;strokeWidth=1.5;dashed=1;edgeStyle=none;" edge="1" parent="1" source="c10" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="IMDSv2" style="rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;strokeWidth=1.5;dashed=0;edgeStyle=none;" edge="1" parent="1" source="c11" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;strokeWidth=1.5;dashed=0;edgeStyle=none;" edge="1" parent="1" source="c12" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="" style="rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;strokeWidth=1.5;dashed=0;edgeStyle=none;" edge="1" parent="1" source="c13" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;strokeWidth=1.5;dashed=0;edgeStyle=none;" edge="1" parent="1" source="c14" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="" style="rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;strokeWidth=1.5;dashed=1;edgeStyle=none;" edge="1" parent="1" source="c15" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="" style="rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;strokeWidth=1.5;dashed=0;edgeStyle=none;" edge="1" parent="1" source="c16" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;막아 둔 것&lt;/b&gt;: 읽기 역할은 셸·아무 주소 포워딩 없음 · plan 역할은 S3 파일 내용·비밀값 거절 · 앱 역할은 photos/ 목록 없음(DB 키로만 지움) · 기록 없는 기본 셸 거절&lt;br&gt;&lt;b&gt;받아들인 한계&lt;/b&gt;: 팀 키가 같아 남의 세션 이름은 못 막음 · 앱·마이그레이션·삭제 컨테이너가 EC2 역할 하나를 같이 씀&lt;br&gt;&lt;b&gt;기록&lt;/b&gt;: 역할/세션 이름이 CloudTrail(예정)과 SSM 세션 기록에 남음 · GitHub OIDC 공급자는 계정 공용(지우지 않음)" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#D5DBDB;fillColor=#FAFAFA;dashed=0;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="680" width="1080" height="84" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>