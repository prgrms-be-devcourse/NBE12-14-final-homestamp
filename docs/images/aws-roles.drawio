<mxfile host="app.diagrams.net"><diagram name="그림 2. 누가 어떤 역할로 무엇을"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="그림 2. 누가 어떤 역할로 무엇을 하나" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="600" height="30" as="geometry"/></mxCell><mxCell id="c4" value="사람은 팀 키 하나, GitHub Actions·서버는 키 없이 임시 자격 증명 · 흐린 점선 = 예정" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="900" height="20" as="geometry"/></mxCell><mxCell id="c5" value="누가" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="200" height="24" as="geometry"/></mxCell><mxCell id="c6" value="어떤 역할로" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="100" width="300" height="24" as="geometry"/></mxCell><mxCell id="c7" value="무엇을" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="100" width="300" height="24" as="geometry"/></mxCell><mxCell id="c8" value="팀원 4명&lt;br&gt;(팀 키 하나)" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.users;fillColor=#232F3E;fontColor=#232F3E;fontSize=12;html=1;" vertex="1" parent="1"><mxGeometry x="110" y="175" width="56" height="56" as="geometry"/></mxCell><mxCell id="c9" value="GitHub Actions&lt;br&gt;infra PR" style="rounded