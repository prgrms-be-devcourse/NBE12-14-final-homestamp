# 롬복 설정 (docs/rules/09 코드 규칙 "롬복", decisions 2026-11-18)
# 허용: @Getter, @NoArgsConstructor(access = AccessLevel.PROTECTED), @RequiredArgsConstructor
# 아래 금지 목록을 쓰면 컴파일 오류가 난다. 롬복 애너테이션은 컴파일 뒤 사라져서 ArchUnit으로는 막을 수 없다.
config.stopBubbling = true

# 롬복이 만든 코드에 @Generated를 붙여 JaCoCo 커버리지에서 뺀다(build.gradle의 *Service 80% 규칙)
lombok.addLombokGeneratedAnnotation = true

# 행동 기록·사실 행은 고칠 수 없고 상태 행도 고칠 칸이 정해져 있다(05 0장). setter를 한꺼번에 열지 않는다
lombok.setter.flagUsage = error
lombok.data.flagUsage = error
# 엔티티의 equals·hashCode·toString은 지연 로딩과 순환 참조를 건드린다
lombok.equalsAndHashCode.flagUsage = error
lombok.toString.flagUsage = error
# 필수 칸을 빠뜨려도 컴파일되어 생성자의 검사를 건너뛴다
lombok.builder.flagUsage = error
# 값 객체는 record를 쓴다
lombok.value.flagUsage = error
