# 롬복 설정 (docs/rules/09 코드 규칙 "롬복", decisions 2026-11-18)
# 허용: @Getter, @NoArgsConstructor(access = AccessLevel.PROTECTED), @RequiredArgsConstructor
# 아래 금지 목록을 쓰면 컴파일 오류가 난다. 롬복 애너테이션은 컴파일 뒤 사라져서 ArchUnit으로는 막을 수 없다.
config.stopBubbling = true

# 롬복이 만든 코드에 @Generated를 붙여 JaCoCo 커버리지에서 뺀다(build.gradle의 *Service 80% 규칙)
lombok.addLombokGeneratedAnnotation = true

# 행동 기록·사실 행은 고칠 수 없고 상태 행도 고칠 칸이 정해져 있다(05 0장). setter를 한꺼번에 열지 않는다
lombok.setter.flagUsage = error
lombok.data.flagUsage = error
# 엔티티의 equals·hashCode·toString은 지연 로딩과 순환 참조를 건드린다
lombok.equalsAndHashCode.flagUsage = error
lombok.toString.flagUsage = error
# 필수 칸을 빠뜨려도 컴파일되어 생성자의 검사를 건너뛴다
lombok.builder.flagUsage = error
lombok.allArgsConstructor.flagUsage = error
# 고칠 수 없는 행을 바꾼 복사본을 만든다
lombok.with.flagUsage = error
# 값 객체는 record를 쓴다
lombok.value.flagUsage = error
# 검사 예외를 숨긴다
lombok.sneakyThrows.flagUsage = error
# 실험 기능(@Accessors·@Delegate 등)과 lombok의 val·var(자바 var 키워드는 그대로 쓴다)
lombok.experimental.flagUsage = error
lombok.val.flagUsage = error
lombok.var.flagUsage = error
# 허용 목록 밖이라 막는다(experimental이 아니어서 위 줄로는 안 막힘). @Slf4j 등을 쓰기로 하면 여기서 빼고 09·decisions 허용 목록에 더한다
lombok.log.flagUsage = error
# null 검사는 생성자에서 Objects.requireNonNull로 손으로 쓴다
lombok.nonNull.flagUsage = error
lombok.synchronized.flagUsage = error
lombok.cleanup.flagUsage = error
lombok.locked.flagUsage = error
lombok.jacksonized.flagUsage = error
# @Getter(lazy = true)는 숨은 캐시 필드를 만든다
lombok.getter.lazy.flagUsage = error
lombok.onX.flagUsage = error
