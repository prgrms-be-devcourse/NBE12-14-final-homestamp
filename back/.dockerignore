# Only the Dockerfile's build inputs enter the context.
**
!gradlew
!settings.gradle
!build.gradle
!lombok.config
!gradle/
!gradle/wrapper/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
!src/
!src/main/
!src/main/**
# 공개 RDS 인증서 묶음 하나만(폴더째 열지 않는다: 키가 섞여도 들어오지 않게)
!certs/rds-ca-ap-northeast-2.crt

# Secrets stay out even if someone places them below src/main.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/application-local*
**/application-prod*
**/application-secret*
**/credentials
**/credentials.*
**/.aws/**
